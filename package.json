{
  "name": "chatdbg-vscode-extension",
  "displayName": "ChatDBG",
  "description": "LLM-assisted interactive debugger integration for ChatDBG inside VS Code.",
  "version": "0.0.1",
  "publisher": "plasma-umass",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": ["Debuggers", "Other"],
  "activationEvents": [
    "onCommand:chatdbg.runCurrentFile",
    "onCommand:chatdbg.runAndExplain",
    "onCommand:chatdbg.rerunLast",
    "onCommand:chatdbg.openLog",
    "onCommand:chatdbg.runWithDiagnostics",
    "onCommand:chatdbg.explainLastError",
    "onCommand:chatdbg.runWithArgs",        
    "onCommand:chatdbg.clearArgs"          
  ],

  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chatdbg.runCurrentFile",
        "title": "ChatDBG: Run Current File",
        "category": "ChatDBG"
      },
      {
         "command": "chatdbg.openLog",          
         "title": "ChatDBG: Open Log (log.yaml)",     
         "category": "ChatDBG" 
      }, 
      {
        "command": "chatdbg.runAndExplain",
        "title": "ChatDBG: Run & Explain",
        "category": "ChatDBG"
      },
      {
        "command": "chatdbg.rerunLast",
        "title": "ChatDBG: Rerun Last",
        "category": "ChatDBG"
      },
      {
        "command": "chatdbg.openLog",
        "title": "ChatDBG: Open Log (log.yaml)",
        "category": "ChatDBG"
      },
      {
        "command": "chatdbg.runWithDiagnostics",
        "title": "ChatDBG: Run & Collect Diagnostics",
        "category": "ChatDBG"
      },
      {
        "command": "chatdbg.explainLastError",
        "title": "ChatDBG: Explain Last Error",
        "category": "ChatDBG"
      }, 
      
      { "command": "chatdbg.runWithArgs", 
        "title": "ChatDBG: Run With Args/Stdin" 
      },

      { "command": "chatdbg.clearArgs",   
        "title": "ChatDBG: Clear Saved Args/Stdin" 
      }

      
    ],
    "configuration": {
      "title": "ChatDBG",
      "properties": {
        "chatdbg.activationCommand": {
          "type": "string",
          "default": "source /opt/miniconda3/bin/activate chatdbg",
          "description": "Shell command used to activate the ChatDBG environment before running ChatDBG."
        },
        "chatdbg.pythonPath": {
          "type": "string",
          "default": "/opt/miniconda3/envs/chatdbg/bin/python",
          "description": "Fallback Python interpreter path if the Python extension setting (python.defaultInterpreterPath) is not set."
        },
        "chatdbg.openaiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional. If set, the extension will `export OPENAI_API_KEY` in the ChatDBG terminal before running. If empty, your shell env is used."
        },

        "chatdbg.unsafe": { "type": "boolean", "default": false, "description": "If true, launch ChatDBG with --unsafe (disables protections; use carefully)." 
        },
        "chatdbg.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "LLM model to use (e.g., gpt-4o). Leave blank to use ChatDBG’s default."
        },
        "chatdbg.format": {
          "type": "string",
          "default": "md",
          "enum": ["text", "md", "md:simple", "jupyter"],
          "markdownDescription": "Output format for ChatDBG. `md` or `md:simple` are good terminal experiences. Leave blank to use ChatDBG’s default."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "tslint": "^6.1.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {}
}
